---
import Layout from '../layouts/Layout.astro';
const articles = [
  { title: 'EnergyHub, a side project to reduce your electricity bill', href: '/thoughts/energyhub' },
  { title: 'The flow of information in AI era', href: '/thoughts/information-in-ai-era' },
];
---
<Layout title="Thoughts — feifan.dev">
  <header><p class="eyebrow">Personal writing</p><h1>Thoughts.</h1></header>
  <div class="writing" aria-label="Articles">
    {articles.map((article, index) => <a href={article.href}><span class="number">0{index + 1}</span><div><h2>{article.title}</h2><span class="status">Not yet published</span></div><span aria-hidden="true">↗</span></a>)}
  </div>
</Layout>
<style>
  .eyebrow{font-size:.75rem;text-transform:uppercase;letter-spacing:.14em}h1{font-size:clamp(3rem,7vw,5rem);letter-spacing:-.05em;line-height:1.1;margin:12px 0 0;font-weight:600}
  .writing{border-top:1px solid var(--panel-border)}.writing>a{display:grid;grid-template-columns:35px 1fr 20px;gap:18px;padding:30px 0;border-bottom:1px solid var(--panel-border);text-decoration:none;align-items:start}.writing>a:hover{background:var(--accent-soft)}
  h2{margin:0 0 12px;font-size:clamp(1.2rem,3vw,1.7rem);line-height:1.35;letter-spacing:-.02em;font-weight:500}.number,.status{font-size:.75rem;color:var(--text-muted)}
  @media(max-width:500px){.writing>a{grid-template-columns:22px 1fr 16px;gap:8px}}
</style>
