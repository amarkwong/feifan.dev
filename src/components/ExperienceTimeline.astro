---
interface ExperienceProject {
  name: string;
  description: string;
  href?: string;
}

interface ExperienceItem {
  company: string;
  role: string;
  period: string;
  year?: string;
  summary: string;
  technologies?: string[];
  projects?: ExperienceProject[];
}

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<career-journey>
  <nav class="career-nav" aria-label="Career history">
    {items.map((item, index) => <a href={`#career-${index}`} data-career={index}><span>{item.period}</span><strong>{item.company}</strong></a>)}
  </nav>
  <div class="career-content">
    {items.map((item, index) => <article id={`career-${index}`} data-panel={index}>
      <p class="period">{item.period}</p>
      <h3>{item.company}</h3><p class="role">{item.role}</p>
      <p>{item.summary}</p>
      <ul class="technologies">{item.technologies?.map(tech => <li>{tech}</li>)}</ul>
      <div class="projects"><h4>Highlighted work</h4>
        {item.projects?.map(project => <details><summary>{project.name}</summary><p>{project.description}</p>{project.href && <a href={project.href} target="_blank" rel="noreferrer">Visit project ↗</a>}</details>)}
      </div>
    </article>)}
  </div>
</career-journey>
<script>
  class CareerJourney extends HTMLElement {
    connectedCallback() {
      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-career]'));
      const panels = Array.from(this.querySelectorAll<HTMLElement>('[data-panel]'));
      const select = (index: number) => {
        links.forEach((link, i) => { if (i === index) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current'); });
        panels.forEach((panel, i) => { panel.hidden = i !== index; });
      };
      links.forEach((link, index) => link.addEventListener('click', event => { event.preventDefault(); select(index); }));
      select(0);
    }
  }
  if (!customElements.get('career-journey')) customElements.define('career-journey', CareerJourney);
</script>
<style>
  career-journey{display:grid;grid-template-columns:240px minmax(0,1fr);gap:32px;align-items:start}
  .career-nav{display:flex;flex-direction:column;border-left:1px solid var(--panel-border)}
  .career-nav a{position:relative;padding:18px 20px;text-decoration:none;color:var(--text-muted);border-radius:0 8px 8px 0}
  .career-nav a::before{content:'';position:absolute;left:-5px;top:28px;width:9px;height:9px;border-radius:50%;background:var(--panel-border)}
  .career-nav a[aria-current]{background:var(--accent-soft);color:var(--accent)}
  .career-nav a[aria-current]::before{background:var(--accent)}
  .career-nav span,.career-nav strong{display:block}.career-nav span{font-size:.72rem;margin-bottom:5px}.career-nav strong{font-size:.95rem;font-weight:600}
  article{padding:30px;background:var(--panel-bg);border:1px solid var(--panel-border);border-radius:10px;margin-bottom:22px;scroll-margin-top:110px}
  article[hidden]{display:none}.period{font-size:.73rem;letter-spacing:.08em;text-transform:uppercase;margin:0 0 16px}
  h3{font-size:1.8rem;line-height:1.2;letter-spacing:-.03em;margin:0 0 8px}.role{font-size:.9rem;margin:0 0 24px}
  .technologies{display:flex;flex-wrap:wrap;list-style:none;gap:7px;padding:0;margin:24px 0}.technologies li{font-size:.75rem;padding:5px 9px;background:var(--accent-soft);border-radius:4px}
  .projects{border-top:1px solid var(--panel-border);padding-top:14px}h4{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);font-weight:500}
  details{border-bottom:1px solid var(--panel-border);padding:12px 0}summary{cursor:pointer;font-size:.9rem;font-weight:500}details p{font-size:.9rem}details a{font-size:.85rem}
  @media(max-width:720px){career-journey{grid-template-columns:1fr;gap:20px}.career-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:0;gap:6px}.career-nav a{border:1px solid var(--panel-border);border-radius:6px;padding:12px}.career-nav a::before{display:none}article{padding:22px}}
</style>
