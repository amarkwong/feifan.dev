# Copy this file to terraform.tfvars and fill in the secrets/IDs below.
# Never commit the real terraform.tfvars file—keep it local or in a secure secrets store.

cloudflare_account_id = "cf-account-id"
cloudflare_api_token  = "CFPAT-..." # Pages + DNS edit permissions

pages_project_name = "feifan-dev"
production_branch  = "main"

github_owner = "amarkwong"
github_repo  = "feifan.dev"

# List every domain you want Cloudflare Pages to serve.
custom_domains = [
  "feifan.dev",
  "www.feifan.dev",
]

# When you want Terraform to create DNS records as well, set the zone apex here.
managed_zone = "feifan.dev"
pages_cname_proxied = true

# Optional environment variables injected into the Astro build.
production_env_vars = {
  NOTION_API_KEY    = "secret"
  NOTION_DATABASE_ID = "secret"
}

preview_env_vars = {
  NOTION_API_KEY    = "secret"
  NOTION_DATABASE_ID = "secret"
}

# --- Resend transactional email ---
# One entry per sending domain registered in Resend. Copy the exact record
# values from Resend → Domains → <domain>. These are public DNS verification
# values, not secrets — but never put the Resend API key here; it belongs
# only to the consuming application's runtime.
# A record is skipped while its value is still ""; unset fields use the
# defaults (mx_priority = 10, dkim_selector = "resend",
# return_path_subdomain = "send", manage_dmarc = true, dmarc_rua = "").
resend_sending_domains = {
  # Discount Tracker <notifications@giftcards.feifan.dev>
  "giftcards.feifan.dev" = {
    mx_value   = "" # e.g. "feedback-smtp.<region>.amazonses.com"
    spf_value  = "" # e.g. "v=spf1 include:amazonses.com ~all"
    dkim_value = "" # long "p=..." value from Resend
  }
  # Default sender on the apex domain.
  "feifan.dev" = {
    mx_value     = ""
    spf_value    = ""
    dkim_value   = ""
    manage_dmarc = false # opt out of publishing _dmarc for the apex
  }
}

# --- Cloudflare Tunnel (homeserver / Discount Tracker) ---
# The defaults create a tunnel named "homeserver" routing
# discounts.feifan.dev -> http://tracker:3000 with a proxied CNAME, while
# giftcards.feifan.dev permanently redirects to it. Nothing is usually needed
# here. Set homeserver_tunnel_name = "" to disable, or add
# entries to homeserver_tunnel_ingress to expose more homeserver services.
# The Cloudflare API token must have Account -> Cloudflare Tunnel -> Edit.
# After apply, the homeserver's TUNNEL_TOKEN comes from:
#   terraform output -raw homeserver_tunnel_token
#
# homeserver_tunnel_name = "homeserver"
# homeserver_tunnel_ingress = [
#   { hostname = "private-app.example.com", service = "http://app:3000" },
#   { hostname = "media.example.com", service = "http://192.0.2.10:8000" },
# ]

# --- Private Lounge (Auth0 + Cloudflare Access) ---
# Leave disabled until the Auth0 Terraform M2M credentials are exported as
# AUTH0_DOMAIN, AUTH0_CLIENT_ID, and AUTH0_CLIENT_SECRET. The Cloudflare token
# also needs Access Apps/Policies and Identity Providers/Groups edit access.
#
# enable_lounge_access        = true
# auth0_domain                = "your-tenant.au.auth0.com"
# auth0_connection_name       = "Username-Password-Authentication"
# cloudflare_access_team_name = "your-team-name"
# owner_email                 = "you@example.com"
# lounge_allowed_emails       = ["you@example.com", "friend@example.com"]
