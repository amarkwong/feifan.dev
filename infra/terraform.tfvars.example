# Copy this file to terraform.tfvars and fill in the secrets/IDs below.
# Never commit the real terraform.tfvars file—keep it local or in a secure secrets store.

cloudflare_account_id = "cf-account-id"
cloudflare_api_token  = "CFPAT-..." # Pages + DNS edit permissions

pages_project_name = "feifan-dev"
production_branch  = "main"

github_owner = "amarkwong"
github_repo  = "feifan.dev"

# List every domain you want Cloudflare Pages to serve.
custom_domains = [
  "feifan.dev",
  "www.feifan.dev",
]

# When you want Terraform to create DNS records as well, set the zone apex here.
managed_zone = "feifan.dev"
pages_cname_proxied = true

# Optional environment variables injected into the Astro build.
production_env_vars = {
  NOTION_API_KEY    = "secret"
  NOTION_DATABASE_ID = "secret"
}

preview_env_vars = {
  NOTION_API_KEY    = "secret"
  NOTION_DATABASE_ID = "secret"
}

# --- Resend transactional email (Discount Tracker) ---
# Sender: Discount Tracker <notifications@giftcards.feifan.dev>
# Copy the exact record values from Resend → Domains → giftcards.feifan.dev.
# These are public DNS verification values, not secrets — but never put the
# Resend API key here; it belongs only to the Discount Tracker runtime.
# A record is skipped while its value is still "".
resend_sending_domain        = "giftcards.feifan.dev"
resend_return_path_subdomain = "send" # match the host shown by Resend
resend_mx_value              = ""     # placeholder, e.g. "feedback-smtp.<region>.amazonses.com"
resend_mx_priority           = 10     # match the priority shown by Resend
resend_spf_value             = ""     # placeholder, e.g. "v=spf1 include:amazonses.com ~all"
resend_dkim_selector         = "resend"
resend_dkim_value            = ""     # placeholder: long "p=..." value from Resend
resend_dmarc_rua             = ""     # optional: mailbox for DMARC aggregate reports
